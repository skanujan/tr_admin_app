<?xml version="1.0" encoding="utf-8"?>
<!-- Your site uses a normal, valid HTTPS certificate, so this just makes that
     explicit and blocks the app from ever falling back to plain http://. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
